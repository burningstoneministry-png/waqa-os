# ============================================================
# Claude-Fire Backend Environment Variables — EXAMPLE FILE
# Copy this to .env and fill in your real values.
# User: Waqa | Fiji
# ============================================================

# ──────────────────────────────────────────────────────────
# SUPABASE (PostgreSQL cloud database)
# Get these from: https://supabase.com → your project → Settings → API
# ──────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ──────────────────────────────────────────────────────────
# GOOGLE APIS (Calendar + Vision)
# Get these from: https://console.cloud.google.com
# Enable: Google Calendar API, Cloud Vision API
# Create OAuth 2.0 credentials (Desktop app type)
# ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_secret_here
GOOGLE_CALENDAR_ID=primary
# Optional: Google Vision API key for OCR (from API & Services → Credentials → API key)
GOOGLE_VISION_API_KEY=AIzaSy...

# ──────────────────────────────────────────────────────────
# EMAIL (Gmail SMTP — requires App Password, NOT your regular password)
# How to get App Password:
# 1. Go to myaccount.google.com → Security → 2-Step Verification (must be ON)
# 2. At bottom: App passwords → Select app: Mail → Generate
# 3. You'll get a 16-character password like: abcd efgh ijkl mnop
# ──────────────────────────────────────────────────────────
EMAIL_ADDRESS=yourname@gmail.com
EMAIL_APP_PASSWORD=abcdefghijklmnop
ALERT_EMAIL=yourname@gmail.com

# Optional: SendGrid (if using SendGrid instead of Gmail SMTP)
# Get from: https://app.sendgrid.com → Settings → API Keys
SENDGRID_API_KEY=SG.your_sendgrid_key_here

# ──────────────────────────────────────────────────────────
# WAKATIME (coding time tracker)
# Get from: https://wakatime.com/settings/account → API Key
# ──────────────────────────────────────────────────────────
WAKATIME_API_KEY=waka_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ──────────────────────────────────────────────────────────
# OLLAMA (local AI — must be installed and running)
# Install: https://ollama.ai
# Run model: ollama pull llama3.2
# Then: ollama serve (starts on port 11434 by default)
# ──────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ──────────────────────────────────────────────────────────
# FLASK APP SETTINGS
# ──────────────────────────────────────────────────────────
# Generate a random secret key: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_random_secret_key_here_make_it_long
FLASK_ENV=development
PORT=5000
